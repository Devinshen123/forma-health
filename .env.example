# Fud AI photo logic is adapted in Forma; the model provider remains OpenAI.
# No Fud AI account, subscription or author service credential is required.
# Server only. Leave blank until you are ready to configure a real OpenAI key.
# This file contains no usable credential. Never put a key in VITE_* variables.
OPENAI_API_KEY=

# Fixed server model: gpt-5.4-mini-2026-03-17. Client cannot choose a model/URL.
# UTC allowances. Reservations are conservative bookkeeping, not actual bills.
# Requests 1..100; reservation .02..1 USD; account daily .02..10 USD,
# project global daily .02..100 USD. Daily limits must cover >= one reservation.
FORMA_AI_DAILY_REQUEST_LIMIT=10
FORMA_AI_RESERVED_USD_PER_ATTEMPT=0.02
FORMA_AI_DAILY_RESERVED_USD_LIMIT=0.40
FORMA_AI_GLOBAL_DAILY_RESERVED_USD_LIMIT=2.00

# Provider timeout 1000..60000 ms. At most one retry; retry delay 0..5000 ms.
FORMA_AI_TIMEOUT_MS=20000
FORMA_AI_RETRY_DELAY_MS=500

# Health cloud integrations: server only. Blank values disable that provider.
# A permanent 32-byte random key, encoded as canonical base64, encrypts tokens.
# Preserve this key across restarts; rotating it requires users to reconnect.
FORMA_HEALTH_TOKEN_KEY=
# Must match your provider-registered callback origins. Third-party approval
# typically requires HTTPS; loopback HTTP is for local development only.
FORMA_HEALTH_PUBLIC_BASE_URL=http://127.0.0.1:3001
# Register /integrations/whoop/callback at the WHOOP developer dashboard.
FORMA_HEALTH_WHOOP_CLIENT_ID=
FORMA_HEALTH_WHOOP_CLIENT_SECRET=
# Register /integrations/oura/callback; Forma uses OAuth code + PKCE S256.
FORMA_HEALTH_OURA_CLIENT_ID=
FORMA_HEALTH_OURA_CLIENT_SECRET=
# Google Health API v4, not legacy Google Fit or Android Health Connect.
# Register /integrations/google-health/callback in a Web OAuth client.
FORMA_HEALTH_GOOGLE_CLIENT_ID=
FORMA_HEALTH_GOOGLE_CLIENT_SECRET=
